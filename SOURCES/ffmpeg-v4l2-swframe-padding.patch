From 92b395dbda19e7765b805ee04294f80c9fcf3ad0 Mon Sep 17 00:00:00 2001
From: fairyband <zl3004431@gmail.com>
Date: Sun, 18 Oct 2026 15:09:38 +0800
Subject: [PATCH 1/2] avcodec/v4l2_buffers: honour driver padding when copying
 frames

v4l2_buffer_swframe_to_buf() used the driver's (possibly padded) buffer
height together with the source frame linesize to compute how much to
copy from each plane.  When the driver aligns the height, e.g. the
Qualcomm Iris encoder reports a 1920x1088 buffer for a 1920x1080 frame,
this reads past the end of the source planes and crashes in memcpy().
It also ignored the driver bytesperline, which breaks the layout when the
frame linesize differs from the driver stride.

Copy only the rows and bytes present in the frame, placing them at the
driver stride and plane offsets, and check that everything fits in the
buffer.
---
 libavcodec/v4l2_buffers.c | 41 ++++++++++++++++++++++++++++++++-------
 1 file changed, 34 insertions(+), 7 deletions(-)

diff --git a/libavcodec/v4l2_buffers.c b/libavcodec/v4l2_buffers.c
index 077c1ee..3ee9f6e 100644
--- a/libavcodec/v4l2_buffers.c
+++ b/libavcodec/v4l2_buffers.c
@@ -28,6 +28,7 @@
 #include <fcntl.h>
 #include <poll.h>
 #include "libavcodec/avcodec.h"
+#include "libavutil/imgutils.h"
 #include "libavutil/pixdesc.h"
 #include "libavutil/refstruct.h"
 #include "v4l2_context.h"
@@ -395,22 +396,48 @@ static int v4l2_buffer_swframe_to_buf(const AVFrame *frame, V4L2Buffer *out)
 
     if (!is_planar_format) {
         const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(frame->format);
+        int bytesperline = out->plane_info[0].bytesperline;
+        unsigned int length = out->plane_info[0].length;
         int planes_nb = 0;
         int offset = 0;
 
         for (i = 0; i < desc->nb_components; i++)
             planes_nb = FFMAX(planes_nb, desc->comp[i].plane + 1);
 
+        /*
+         * The buffer layout follows the driver format, which may be padded
+         * beyond the frame (e.g. a 1920x1080 frame in a 1920x1088 buffer).
+         * Copy only the rows and bytes present in the frame, placing them at
+         * the driver stride and plane offsets.
+         */
         for (i = 0; i < planes_nb; i++) {
-            int size, h = height;
+            int dst_linesize = bytesperline;
+            int dst_h = height;
+            int src_h = frame->height;
+            int bytewidth = av_image_get_linesize(frame->format, frame->width, i);
+
             if (i == 1 || i == 2) {
-                h = AV_CEIL_RSHIFT(h, desc->log2_chroma_h);
+                dst_h = AV_CEIL_RSHIFT(dst_h, desc->log2_chroma_h);
+                src_h = AV_CEIL_RSHIFT(src_h, desc->log2_chroma_h);
+                if (planes_nb > 2)
+                    dst_linesize = AV_CEIL_RSHIFT(dst_linesize, desc->log2_chroma_w);
             }
-            size = frame->linesize[i] * h;
-            ret = v4l2_bufref_to_buf(out, 0, frame->data[i], size, offset);
-            if (ret)
-                return ret;
-            offset += size;
+            if (bytewidth < 0 || bytewidth > dst_linesize || src_h > dst_h ||
+                (int64_t)offset + (int64_t)dst_linesize * dst_h > length)
+                return AVERROR(EINVAL);
+
+            av_image_copy_plane((uint8_t *)out->plane_info[0].mm_addr + offset,
+                                dst_linesize, frame->data[i], frame->linesize[i],
+                                bytewidth, src_h);
+            offset += dst_linesize * dst_h;
+        }
+
+        if (V4L2_TYPE_IS_MULTIPLANAR(out->buf.type)) {
+            out->planes[0].bytesused = offset;
+            out->planes[0].length = length;
+        } else {
+            out->buf.bytesused = offset;
+            out->buf.length = length;
         }
         return 0;
     }
