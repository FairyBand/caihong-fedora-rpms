From 25605d4f0f346367b82559342c683c16e980c200 Mon Sep 17 00:00:00 2001
From: Michael Niedermayer <michael@niedermayer.cc>
Date: Thu, 8 Oct 2026 04:59:41 +0000
Subject: [PATCH 1/2] avcodec: export reorder delay when H.264/HEVC decoders
 are disabled

Matroska supplies presentation timestamps without decoding timestamps.
Without the native decoders, the H.264 parser only triggers demux.c's
one-frame B-picture heuristic, while HEVC is not parsed at all. Reorder
depths larger than those guesses produce invalid DTS and cause streamcopy
to modify PTS.

Export the SPS reorder bound from the parsers in these configurations,
and allow Matroska to use the HEVC parser when its native decoder is
absent. Preserve a larger delay already reported by another component.
Keep native-decoder builds unchanged so H.264 can still refine its delay
from observed picture order where appropriate.

This follows the parser-based approach proposed by tyan0 in #23365.
There is no need to force MAX_REORDER_DELAY in demux.c for these streams.
Keep the B-picture heuristic from overriding a parser-provided zero HEVC
reorder bound: low-delay B slices need not reorder, and inventing a delay
mid-stream produces a missing DTS followed by duplicate DTS on MP4 remux.

Fixes #23365.

Assisted-by: Fairy
---
 libavcodec/h264_parser.c  | 8 ++++++++
 libavcodec/hevc/parser.c  | 9 +++++++++
 libavformat/demux.c       | 5 ++++-
 libavformat/matroskadec.c | 3 ++-
 4 files changed, 23 insertions(+), 2 deletions(-)

diff --git a/libavcodec/h264_parser.c b/libavcodec/h264_parser.c
index 1bd0be38a53..8b77757d3b3 100644
--- a/libavcodec/h264_parser.c
+++ b/libavcodec/h264_parser.c
@@ -27,6 +27,8 @@
 
 #define UNCHECKED_BITSTREAM_READER 1
 
+#include "config_components.h"
+
 #include <stdint.h>
 
 #include "libavutil/attributes.h"
@@ -385,6 +387,12 @@ static inline int parse_nal_units(AVCodecParserContext *s,
             p->ps.sps = p->ps.pps->sps;
             sps       = p->ps.sps;
 
+#if !CONFIG_H264_DECODER
+            // Use the SPS reorder bound when the decoder cannot refine it.
+            avctx->has_b_frames = FFMAX(avctx->has_b_frames,
+                                       sps->num_reorder_frames);
+#endif
+
             // heuristic to detect non marked keyframes
             if (p->ps.sps->ref_frame_count <= 1 && p->ps.pps->ref_count[0] <= 1 && s->pict_type == AV_PICTURE_TYPE_I)
                 s->key_frame = 1;
diff --git a/libavcodec/hevc/parser.c b/libavcodec/hevc/parser.c
index 47a1ac70d00..0830e7089db 100644
--- a/libavcodec/hevc/parser.c
+++ b/libavcodec/hevc/parser.c
@@ -20,6 +20,8 @@
  * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
  */
 
+#include "config_components.h"
+
 #include "libavutil/common.h"
 #include "libavutil/mem.h"
 
@@ -95,6 +97,13 @@ static int hevc_parse_slice_header(AVCodecParserContext *s, H2645NAL *nal,
     avctx->profile  = sps->ptl.general_ptl.profile_idc;
     avctx->level    = sps->ptl.general_ptl.level_idc;
 
+#if !CONFIG_HEVC_DECODER
+    // Without the native decoder, provide the delay needed for DTS generation.
+    avctx->has_b_frames =
+        FFMAX(avctx->has_b_frames,
+              sps->temporal_layer[sps->max_sub_layers - 1].num_reorder_pics);
+#endif
+
     if (sps->vps->vps_timing_info_present_flag) {
         num = sps->vps->vps_num_units_in_tick;
         den = sps->vps->vps_time_scale;
diff --git a/libavformat/demux.c b/libavformat/demux.c
index 97eaa5f9bcc..81c606f8a40 100644
--- a/libavformat/demux.c
+++ b/libavformat/demux.c
@@ -1022,8 +1022,11 @@ static void compute_pkt_fields(AVFormatContext *s, AVStream *st,
     if ((s->flags & AVFMT_FLAG_IGNDTS) && pkt->pts != AV_NOPTS_VALUE)
         pkt->dts = AV_NOPTS_VALUE;
 
+    /* Without the native HEVC decoder, the parser has already supplied the
+     * SPS reorder bound. B slices do not necessarily imply reordering. */
     if (pc && pc->pict_type == AV_PICTURE_TYPE_B
-        && !sti->avctx->has_b_frames)
+        && !sti->avctx->has_b_frames
+        && (CONFIG_HEVC_DECODER || sti->avctx->codec_id != AV_CODEC_ID_HEVC))
         //FIXME Set low_delay = 0 when has_b_frames = 1
         sti->avctx->has_b_frames = 1;
 
diff --git a/libavformat/matroskadec.c b/libavformat/matroskadec.c
index bceb4f7e17e..e05c3fe4f0f 100644
--- a/libavformat/matroskadec.c
+++ b/libavformat/matroskadec.c
@@ -3058,7 +3058,8 @@ static int mkv_parse_video(MatroskaTrack *track, AVStream *st,
         bytestream_put_le32(&cropping, track->video.pixel_cropl);
         bytestream_put_le32(&cropping, track->video.pixel_cropr);
     }
-    if (par->codec_id != AV_CODEC_ID_HEVC)
+    // The HEVC parser supplies the reorder delay when the decoder is disabled.
+    if (!CONFIG_HEVC_DECODER || par->codec_id != AV_CODEC_ID_HEVC)
         sti->need_parsing = AVSTREAM_PARSE_HEADERS;
 
     if (track->default_duration) {
-- 
