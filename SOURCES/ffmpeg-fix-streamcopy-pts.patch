From 83b532813a88048c6b28592b885c2fb233461e41 Mon Sep 17 00:00:00 2001
From: Michael Niedermayer <michael@niedermayer.cc>
Date: Thu, 8 Oct 2026 04:59:41 +0000
Subject: [PATCH 2/2] fate/matroska: cover streamcopy without native H.264/HEVC
 decoders

Remux existing MP4 samples to Matroska, then streamcopy to framecrc.
Verify the reconstructed DTS, preserved PTS and packet payloads when
the native decoders are disabled. The H.264 sample also exercises the
level-derived reorder bound without explicit bitstream restrictions.

The MP4-based tests fail before the parser reorder-delay fix and pass with
it, with no decoders enabled and with libopenh264 enabled.

Also remux eight frames from the existing AMP_F_Hisilicon_3 HEVC
conformance sample, using setts to supply timestamps. Its low-delay B
slices have an SPS reorder bound of zero. Check that the B-picture
heuristic does not invent a delay mid-stream, which would produce a
missing DTS followed by duplicate DTS on streamcopy.

Assisted-by: Fairy
---
 tests/fate/matroska.mak                       | 15 +++++++++
 tests/ref/fate/matroska-h264-remux-nodec      | 33 +++++++++++++++++++
 tests/ref/fate/matroska-hevc-remux-nodec      | 28 ++++++++++++++++
 .../fate/matroska-hevc-remux-nodec-lowdelay   | 16 +++++++++
 4 files changed, 92 insertions(+)
 create mode 100644 tests/ref/fate/matroska-h264-remux-nodec
 create mode 100644 tests/ref/fate/matroska-hevc-remux-nodec
 create mode 100644 tests/ref/fate/matroska-hevc-remux-nodec-lowdelay

diff --git a/tests/fate/matroska.mak b/tests/fate/matroska.mak
index f165ce19476..e831e6cc428 100644
--- a/tests/fate/matroska.mak
+++ b/tests/fate/matroska.mak
@@ -1,3 +1,18 @@
+# Exercise parser-provided reorder delays without the native decoders.
+ifndef CONFIG_H264_DECODER
+FATE_MATROSKA-$(call REMUX, MATROSKA, MOV_DEMUXER H264_PARSER) += fate-matroska-h264-remux-nodec
+fate-matroska-h264-remux-nodec: CMD = transcode mov $(TARGET_SAMPLES)/h264/h264_3bf_pyramid_nobsrestriction.mp4 matroska "-map 0:v:0 -c copy" "-map 0:v:0 -c copy"
+endif
+
+ifndef CONFIG_HEVC_DECODER
+FATE_MATROSKA-$(call REMUX, MATROSKA, MOV_DEMUXER HEVC_PARSER) += fate-matroska-hevc-remux-nodec
+fate-matroska-hevc-remux-nodec: CMD = transcode mov $(TARGET_SAMPLES)/hevc/dv84.mov matroska "-map 0:v:0 -c copy -frames:v 20" "-map 0:v:0 -c copy"
+
+# Low-delay B slices must retain the SPS reorder bound of zero.
+FATE_MATROSKA-$(call REMUX, MATROSKA, HEVC_DEMUXER HEVC_PARSER EXTRACT_EXTRADATA_BSF SETTS_BSF) += fate-matroska-hevc-remux-nodec-lowdelay
+fate-matroska-hevc-remux-nodec-lowdelay: CMD = transcode hevc $(TARGET_SAMPLES)/hevc-conformance/AMP_F_Hisilicon_3.bit matroska "-map 0:v:0 -c copy -frames:v 8 -bsf:v setts=pts=N:dts=N:time_base=1/25" "-map 0:v:0 -c copy" "" "" "" "-r 25"
+endif
+
 FATE_MATROSKA-$(call FRAMECRC, MATROSKA,, ZLIB) += fate-matroska-prores-zlib
 fate-matroska-prores-zlib: CMD = framecrc -i $(TARGET_SAMPLES)/mkv/prores_zlib.mkv -c:v copy
 
